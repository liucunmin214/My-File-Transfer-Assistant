<Window x:Class="MyFileTransferAssistant.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="My File Transfer Assistant"
        Width="1220" Height="800" MinWidth="1024" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource ContentBrush}"
        Closing="Window_Closing" StateChanged="Window_StateChanged">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                      GlassFrameThickness="0" CornerRadius="12" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="224" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左侧导航 -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}" Padding="18,24,18,18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0">
                    <Border Width="46" Height="46" CornerRadius="14" HorizontalAlignment="Left"
                            Background="{DynamicResource AccentBrush}">
                        <TextBlock Text="传" Foreground="White" FontSize="22" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="文件传输助手" FontSize="18" FontWeight="SemiBold" Margin="2,16,0,4" />
                    <TextBlock Text="My File Transfer Assistant" Style="{StaticResource MutedText}" Margin="2,0,0,0" />
                    <StackPanel Margin="0,30,0,0">
                        <RadioButton x:Name="NavSend" Style="{StaticResource NavButton}" Content="发送文件"
                                     IsChecked="True" Checked="Nav_Checked" />
                        <RadioButton x:Name="NavReceive" Style="{StaticResource NavButton}" Content="接收文件"
                                     Checked="Nav_Checked" />
                        <RadioButton x:Name="NavSettings" Style="{StaticResource NavButton}" Content="设置"
                                     Checked="Nav_Checked" />
                        <RadioButton x:Name="NavAbout" Style="{StaticResource NavButton}" Content="关于与更新"
                                     Checked="Nav_Checked" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Row="2">
                    <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,0,0,14" />
                    <TextBlock x:Name="SidebarDeviceName" Style="{StaticResource SubText}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="V1.3.0  ·  WPF 界面" Style="{StaticResource MutedText}" Margin="0,6,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 自定义标题栏 -->
            <Border Grid.Row="0" x:Name="TitleBar" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="24,0,10,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="PageTitle" Text="发送文件" FontSize="16" FontWeight="SemiBold" />
                        <Border Margin="16,0,0,0" Padding="10,4" CornerRadius="10"
                                Background="{DynamicResource AccentSoftBrush}">
                            <TextBlock x:Name="GlobalStatus" Text="待机" FontSize="12"
                                       Foreground="{DynamicResource AccentBrush}" />
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="MinButton" Style="{StaticResource TitleButton}" Content="—" Click="MinButton_Click" />
                        <Button x:Name="MaxButton" Style="{StaticResource TitleButton}" Content="□" Click="MaxButton_Click" />
                        <Button x:Name="CloseButton" Style="{StaticResource CloseButton}" Content="×" Click="CloseButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 发送页 -->
            <ScrollViewer x:Name="PageSend" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,4,24,24">
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="附近设备" Style="{StaticResource CardTitle}" />
                                <Button Content="刷新" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right"
                                        Click="RefreshDevices_Click" />
                            </Grid>
                            <TextBlock Text="选择自动发现的设备，或手动添加对方 IP。接收端需要先开启接收服务。"
                                       Style="{StaticResource SubText}" Margin="0,8,0,14" />
                            <ListView x:Name="DeviceList" Height="210" SelectionMode="Single">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="设备名称" Width="250" DisplayMemberBinding="{Binding Name}" />
                                        <GridViewColumn Header="IP 地址" Width="190" DisplayMemberBinding="{Binding Ip}" />
                                        <GridViewColumn Header="端口" Width="90" DisplayMemberBinding="{Binding Port}" />
                                        <GridViewColumn Header="状态" Width="90" DisplayMemberBinding="{Binding Status}" />
                                    </GridView>
                                </ListView.View>
                            </ListView>
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ManualIp" Grid.Column="0" Style="{StaticResource Input}"
                                         Margin="0,0,10,0" ToolTip="对方 IP 地址" />
                                <TextBox x:Name="ManualPort" Grid.Column="1" Style="{StaticResource Input}"
                                         Text="51831" Margin="0,0,10,0" ToolTip="对方接收端口" />
                                <Button Grid.Column="2" Content="+ 添加设备" Style="{StaticResource SecondaryButton}"
                                        Click="AddManualDevice_Click" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="待发送文件" Style="{StaticResource CardTitle}" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="选择文件" Style="{StaticResource AccentButton}" MinHeight="36" Padding="16,7"
                                            Click="PickFiles_Click" />
                                    <Button Content="选择文件夹" Style="{StaticResource SecondaryButton}" MinHeight="36" Padding="14,7"
                                            Margin="10,0,0,0" Click="PickFolder_Click" />
                                    <Button Content="移除" Style="{StaticResource SecondaryButton}" MinHeight="36" Padding="14,7"
                                            Margin="10,0,0,0" Click="RemoveFiles_Click" />
                                    <Button Content="清空" Style="{StaticResource DangerButton}" MinHeight="36" Padding="14,7"
                                            Margin="10,0,0,0" Click="ClearFiles_Click" />
                                </StackPanel>
                            </Grid>
                            <ListView x:Name="SendFileList" Height="190" Margin="0,14,0,0" SelectionMode="Extended">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="文件名" Width="260" DisplayMemberBinding="{Binding Name}" />
                                        <GridViewColumn Header="大小" Width="110" DisplayMemberBinding="{Binding SizeText}" />
                                        <GridViewColumn Header="发送后的相对路径" Width="380" DisplayMemberBinding="{Binding RelativeName}" />
                                    </GridView>
                                </ListView.View>
                            </ListView>
                            <TextBlock x:Name="SendSummary" Style="{StaticResource MutedText}" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="发送进度" Style="{StaticResource CardTitle}" />
                                <TextBlock x:Name="SendSpeedText" Text="--" Style="{StaticResource SubText}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <ProgressBar x:Name="SendProgressBar" Margin="0,16,0,10" Minimum="0" Maximum="100" />
                            <TextBlock x:Name="SendProgressText" Text="选择目标设备和文件后，点击发送开始传输。"
                                       Style="{StaticResource SubText}" />
                            <ListBox x:Name="SendLog" Height="100" Margin="0,12,0,0" Padding="8" FontSize="12" />
                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="SendButton" Grid.Column="0" Content="发送" Style="{StaticResource AccentButton}"
                                        FontSize="16" Click="SendButton_Click" />
                                <Button x:Name="CancelSendButton" Grid.Column="1" Content="取消" Style="{StaticResource DangerButton}"
                                        Margin="12,0,0,0" IsEnabled="False" Click="CancelSend_Click" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 接收页 -->
            <ScrollViewer x:Name="PageReceive" Grid.Row="1" Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto" Padding="24,4,24,24">
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="接收服务" Style="{StaticResource CardTitle}" />
                                <TextBlock x:Name="ReceiveStatusText" Text="未开启" Style="{StaticResource SubText}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <Grid Margin="0,18,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="监听端口" VerticalAlignment="Center" />
                                <TextBox x:Name="ReceivePortBox" Grid.Column="1" Style="{StaticResource Input}" MaxWidth="180"
                                         HorizontalAlignment="Left" />
                                <Button x:Name="ReceiveToggleButton" Grid.Column="2" Content="开启接收服务"
                                        Style="{StaticResource AccentButton}" Click="ReceiveToggle_Click" />
                            </Grid>
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="保存目录" VerticalAlignment="Center" />
                                <TextBox x:Name="ReceiveDirBox" Grid.Column="1" Style="{StaticResource Input}" Margin="0,0,10,0" />
                                <Button Grid.Column="2" Content="浏览…" Style="{StaticResource SecondaryButton}"
                                        Click="BrowseReceiveDir_Click" />
                            </Grid>
                            <WrapPanel Margin="110,14,0,0">
                                <TextBlock x:Name="LocalIpText" Style="{StaticResource SubText}" />
                                <Button Content="打开保存目录" Style="{StaticResource SecondaryButton}" MinHeight="32" Padding="12,5"
                                        Margin="20,0,0,0" Click="OpenReceiveDir_Click" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="接收记录" Style="{StaticResource CardTitle}" />
                                <Button Content="清空记录" Style="{StaticResource SecondaryButton}" MinHeight="32" Padding="12,5"
                                        HorizontalAlignment="Right" Click="ClearReceiveLog_Click" />
                            </Grid>
                            <ProgressBar x:Name="ReceiveProgressBar" Margin="0,16,0,10" Minimum="0" Maximum="100" />
                            <TextBlock x:Name="ReceiveProgressText" Text="开启服务后，其他设备即可向你发送文件。"
                                       Style="{StaticResource SubText}" />
                            <ListView x:Name="ReceiveList" Height="330" Margin="0,14,0,0">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="时间" Width="90" DisplayMemberBinding="{Binding Time}" />
                                        <GridViewColumn Header="文件" Width="250" DisplayMemberBinding="{Binding Name}" />
                                        <GridViewColumn Header="大小" Width="100" DisplayMemberBinding="{Binding SizeText}" />
                                        <GridViewColumn Header="状态" Width="110" DisplayMemberBinding="{Binding Status}" />
                                        <GridViewColumn Header="保存位置 / 说明" Width="360" DisplayMemberBinding="{Binding Detail}" />
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 设置页 -->
            <ScrollViewer x:Name="PageSettings" Grid.Row="1" Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto" Padding="24,4,24,24">
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="基本设置" Style="{StaticResource CardTitle}" />
                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="设备昵称" VerticalAlignment="Center" />
                                <TextBox x:Name="NickBox" Grid.Column="1" Style="{StaticResource Input}" MaxLength="63" />
                                <TextBlock Grid.Row="1" Text="默认保存目录" VerticalAlignment="Center" Margin="0,14,0,0" />
                                <Grid Grid.Row="1" Grid.Column="1" Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="SettingsSaveDirBox" Style="{StaticResource Input}" Margin="0,0,10,0" />
                                    <Button Grid.Column="1" Content="浏览…" Style="{StaticResource SecondaryButton}"
                                            Click="BrowseSettingsDir_Click" />
                                </Grid>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="外观" Style="{StaticResource CardTitle}" />
                            <Grid Margin="0,14,0,0">
                                <TextBlock Text="深色模式" VerticalAlignment="Center" />
                                <ToggleButton x:Name="DarkSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                              Checked="DarkSwitch_Changed" Unchecked="DarkSwitch_Changed" />
                            </Grid>
                            <TextBlock Text="主题色" Style="{StaticResource SubText}" Margin="0,18,0,10" />
                            <WrapPanel x:Name="ThemePanel" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="网络与系统集成" Style="{StaticResource CardTitle}" />
                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="TCP 传输端口" VerticalAlignment="Center" />
                                <TextBox x:Name="TcpPortBox" Grid.Column="1" Style="{StaticResource Input}" Margin="0,0,20,0" />
                                <TextBlock Grid.Column="2" Text="UDP 发现端口" VerticalAlignment="Center" />
                                <TextBox x:Name="UdpPortBox" Grid.Column="3" Style="{StaticResource Input}" />
                            </Grid>
                            <Grid Margin="0,16,0,0">
                                <TextBlock Text="开机自动启动" VerticalAlignment="Center" />
                                <ToggleButton x:Name="AutostartSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Text="资源管理器右键菜单" VerticalAlignment="Center" />
                                    <TextBlock Text="在文件和文件夹右键中添加「发送到附近设备…」" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                                </StackPanel>
                                <ToggleButton x:Name="ShellMenuSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="软件更新" Style="{StaticResource CardTitle}" />
                            <Grid Margin="0,14,0,0">
                                <TextBlock Text="启动时自动检查更新" VerticalAlignment="Center" />
                                <ToggleButton x:Name="AutoUpdateSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right" />
                            </Grid>
                            <TextBlock Text="update.json 地址" Style="{StaticResource SubText}" Margin="0,16,0,8" />
                            <TextBox x:Name="UpdateUrlBox" Style="{StaticResource Input}" />
                            <TextBlock Text="留空则禁用更新检查。自建更新服务后再填写服务器地址。"
                                       Style="{StaticResource MutedText}" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <Grid>
                        <Button Content="保存设置" Style="{StaticResource AccentButton}" HorizontalAlignment="Left"
                                Padding="28,11" Click="SaveSettings_Click" />
                        <TextBlock x:Name="SettingsStatus" Style="{StaticResource SubText}" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- 关于页 -->
            <ScrollViewer x:Name="PageAbout" Grid.Row="1" Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto" Padding="24,4,24,24">
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Border Width="64" Height="64" CornerRadius="18" Background="{DynamicResource AccentBrush}"
                                    HorizontalAlignment="Left">
                                <TextBlock Text="传" Foreground="White" FontSize="30" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="My File Transfer Assistant" FontSize="24" FontWeight="SemiBold" Margin="0,18,0,6" />
                            <TextBlock Text="版本 V1.3.0  ·  WPF + XAML 界面" Style="{StaticResource SubText}" />
                            <TextBlock Text="一款 Windows 局域网文件传输工具。界面使用 WPF 重写，设备发现、配置与文件传输仍由原生 C 核心 sync_core.dll 提供。"
                                       Style="{StaticResource SubText}" Margin="0,18,0,0" />
                            <TextBlock Margin="0,14,0,0">
                                <Hyperlink x:Name="RepoHyperlink" RequestNavigate="RepoHyperlink_RequestNavigate"
                                           NavigateUri="https://github.com/liucunmin214/My-File-Transfer-Assistant">
                                    GitHub 开源仓库
                                </Hyperlink>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="检查更新" Style="{StaticResource CardTitle}" />
                            <TextBlock x:Name="UpdateStatus" Text="尚未检查" Style="{StaticResource SubText}" Margin="0,12,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                <Button x:Name="CheckUpdateButton" Content="检查更新" Style="{StaticResource AccentButton}"
                                        Click="CheckUpdate_Click" />
                                <Button Content="打开日志目录" Style="{StaticResource SecondaryButton}" Margin="12,0,0,0"
                                        Click="OpenLog_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
