<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MyFileTransferAssistant</AssemblyName>
    <RootNamespace>MyFileTransferAssistant</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationIcon>..\resources\icon.ico</ApplicationIcon>
    <Version>1.3.0</Version>
    <AssemblyVersion>1.3.0.0</AssemblyVersion>
    <FileVersion>1.3.0.0</FileVersion>
    <Description>My File Transfer Assistant - LAN file transfer</Description>
    <Company>MY Studio</Company>
    <Product>My File Transfer Assistant</Product>
  </PropertyGroup>

</Project>
